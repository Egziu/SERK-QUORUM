# SERK QUORUM — local development settings. Copy to .env (git-ignored).
# Never put production secrets in this file or in the repository.

# Application role (member of quorum_app; owns nothing; cannot bypass RLS)
DATABASE_URL=postgres://quorum_api:quorum_api_dev@127.0.0.1:5432/quorum_dev
# Schema owner role, used only by `quorum-api migrate`
QUORUM_MIGRATION_DATABASE_URL=postgres://quorum_owner:quorum_owner_dev@127.0.0.1:5432/quorum_dev

QUORUM_BIND=127.0.0.1:8080
QUORUM_WEB_DIR=apps/web/dist
# Local HTTP only. Must be 1 (default) behind HTTPS.
QUORUM_COOKIE_SECURE=0
# Self-service sign-up. Default off.
QUORUM_ALLOW_SIGNUP=1
QUORUM_SESSION_TTL_HOURS=12
QUORUM_INVITATION_TTL_HOURS=72
QUORUM_DB_MAX_CONNECTIONS=10
# QUORUM_LOG_FORMAT=json

# Live AI providers: off by default. Fixtures need no keys.
# A provider is "configured" only when both its key and model are set.
QUORUM_PROVIDERS_LIVE=0
QUORUM_PROVIDER_TIMEOUT_SECONDS=45
QUORUM_PROVIDER_MAX_OUTPUT_TOKENS=1200
QUORUM_PROVIDER_COOLDOWN_SECONDS=5
QUORUM_PROVIDER_CONCURRENCY=4
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=
